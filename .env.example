APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Comma-separated frontend origins (exact match; required when supports_credentials is true)
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://192.168.1.11:5174,http://localhost:5175

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=socketio
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Socket.IO sidecar (realtime/). Use https URL in production for WSS via reverse proxy.
# Notifications use SSE (GET /api/v1/notifications/stream), not Socket.IO.
SOCKET_IO_URL=http://127.0.0.1:3001
SOCKET_IO_PATH=/socket.io
SOCKET_IO_SECRET=change-me-to-a-long-random-string

# Notifications SSE stream (shared-hosting friendly)
NOTIFICATIONS_SSE_POLL_SECONDS=1
NOTIFICATIONS_SSE_HEARTBEAT_SECONDS=10
NOTIFICATIONS_SSE_MAX_DURATION_SECONDS=25
NOTIFICATIONS_SSE_REPLAY_LIMIT=100
NOTIFICATIONS_SSE_BATCH_LIMIT=50
NOTIFICATIONS_SSE_RETRY_MILLISECONDS=3000


CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
